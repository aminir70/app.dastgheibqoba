# ---------- Database ----------
POSTGRES_USER=chatbot
# ⚠️ رمز پیش‌فرض را عوض کنید و همان را در DATABASE_URL هم بگذارید
POSTGRES_PASSWORD=chatbot
POSTGRES_DB=chatbot
DATABASE_URL=postgresql+psycopg2://chatbot:chatbot@db:5432/chatbot

# ---------- Redis ----------
REDIS_URL=redis://redis:6379/0

# ---------- OpenAI ----------
OPENAI_API_KEY=sk-...
# سرور ایران است: آدرس سرویس واسط سازگار با OpenAI را اینجا بگذار
# (مثل AvalAI: https://api.avalai.ir/v1  یا GapGPT: https://api.gapgpt.app/v1)
OPENAI_BASE_URL=

# ---------- Auth / Security ----------
# ⚠️ هر دو مقدار زیر الزامی هستند. اگر خالی یا کوتاه باشند سرویس بالا نمی‌آید
# (چون کلید خالی یعنی هر کسی می‌تواند توکن معتبر بسازد).
#
# ⚠️ مهم: باید دقیقاً همان JWT_SECRET اپ اصلی (/opt/myapp/.env) باشد
# تا ورود یکپارچه (SSO) کاربران کار کند. حداقل ۳۲ نویسه.
JWT_SECRET=
# رمز پنل مدیریت چت‌بات (در تب «دستیار هوشمند» پنل ادمین اپ وارد می‌شود)
# حداقل ۸ نویسه.
ADMIN_PASSWORD=
# در production حتماً false بماند — در حالت true متن خطاهای داخلی به کلاینت
# برمی‌گردد و بررسی الزامی بودن کلیدها به هشدار تبدیل می‌شود.
DEBUG=false

# ---------- SMS (Kavenegar) — فعلاً غیرفعال ----------
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=otp-verify

# ---------- Files ----------
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=200
