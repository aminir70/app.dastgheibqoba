# نمونه تنظیمات محیطی — کپی کنید به .env و مقادیر واقعی بگذارید
NODE_ENV=production
PORT=3000

# --- الزامی ---
# رمز ورود پنل ادمین (حداقل ۸ کاراکتر). اگر تنظیم نشود یک رمز تصادفی برای همان
# اجرا ساخته می‌شود و در لاگ چاپ می‌گردد.
ADMIN_PASSWORD=your_admin_password_here

# کلید امضای JWT (حداقل ۳۲ کاراکتر). اگر تنظیم نشود، یک کلید تصادفی ساخته و در
# جدول settings ذخیره می‌شود تا بعد از restart توکن‌ها معتبر بمانند.
JWT_SECRET=your_secret_key_here

# origin های مجاز برای cross-origin (با کاما جدا شوند).
# درخواست‌های هم‌origin همیشه مجازند و نیازی به لیست شدن ندارند.
ALLOWED_ORIGINS=https://app.dastgheibqoba.info

# --- Push Notifications (اختیاری ولی توصیه‌شده) ---
# اگر خالی بمانند، سرور یک بار کلید می‌سازد و در جدول settings ذخیره می‌کند
# (اشتراک‌ها بعد از restart سالم می‌مانند). مقداردهی اینجا همچنان بهتر است.
# ساخت دستی:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:admin@dastgheibqoba.info

# آدرس سرویس چت‌بات که /chatbot به آن پروکسی می‌شود
CHATBOT_URL=http://127.0.0.1:8000

# --- اختیاری ---
# دامنه‌های مجاز برای /api/proxy (با کاما). خالی = پروکسی غیرفعال است.
# خالی گذاشتن توصیه می‌شود؛ بدون allowlist این endpoint یک open proxy است.
PROXY_ALLOWED_HOSTS=

# فقط برای عیب‌یابی: CSP را خاموش می‌کند. در production خاموش نکنید.
# CSP_DISABLED=1
